  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node scripts/native-compat-test.mjs && node scripts/store-account-test.mjs && node scripts/notifications-test.mjs && node scripts/mutation-test.mjs && node scripts/phone-test.mjs && node scripts/packet-test.mjs && node scripts/business-test.mjs && node scripts/contract-revenue-test.mjs && node scripts/today-test.mjs && node scripts/intelligence-test.mjs && node scripts/voice-test.mjs",
    "quality": "npm run typecheck && npm test",
    "eas-build-pre-install": "npm install --global npm@10.9.8"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-dev-client",
        "expo-crypto",
        "expo-file-system",
        "expo-font",
        "expo-image-picker",
        "expo-notifications",
        "expo-secure-store",
        "expo-updates",
        "react-native"
      ]
    }
