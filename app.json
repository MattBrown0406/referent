{
  "expo": {
    "name": "ReferralFit",
    "slug": "referralfit",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-referent-symbiosis.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mattbrown.referralfit",
      "buildNumber": "1",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon-referent-symbiosis.png",
      "bundler": "metro",
      "output": "single",
      "name": "ReferralFit",
      "shortName": "ReferralFit",
      "description": "ReferralFit for practices: cases, placement matches, and your referral network.",
      "themeColor": "#1F5A49",
      "backgroundColor": "#F6F4EE"
    },
    "scheme": "referralfit",
    "plugins": [
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "ReferralFit uses Face ID to unlock the app, so your cases stay private if someone else picks up your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "referralfit"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReferralFit opens your photo library only when you choose to attach a photo, such as an insurance card or a signed agreement, to a private case file.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "ReferralFit uses only the contacts you pick, one at a time, to add them as referral partners. It never reads the rest of your address book."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "931063d5-1135-428d-adb9-572c7fe0885e"
      }
    },
    "owner": "mattbrown0406",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/931063d5-1135-428d-adb9-572c7fe0885e"
    }
  }
}
